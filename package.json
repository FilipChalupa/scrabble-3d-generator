{
	"name": "scrabble-3d-generator",
	"private": true,
	"type": "module",
	"description": "Generátor kamenů do Scrabble pro 3D tisk. Web je statický; npm slouží jen pro vývoj a testy.",
	"scripts": {
		"start": "node scripts/serve.mjs",
		"test": "node --import ./test/register.js --test 'test/*.test.js'",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots.mjs",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write . && eslint --fix ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"earcut": "3.0.2",
		"eslint": "^10.12.0",
		"fflate": "0.8.2",
		"globals": "^17.13.0",
		"opentype.js": "1.3.4",
		"polygon-clipping": "0.15.7",
		"prettier": "^3.9.9"
	}
}
